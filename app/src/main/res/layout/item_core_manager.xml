<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="0dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Core Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/coreName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Core Name"
                    android:textSize="14sp"
                    android:textColor="@color/kitt_red"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSTALLED"
                    android:textSize="10sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#4CAF50"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/coreId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="core_id"
                android:textSize="11sp"
                android:textColor="#888888"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/coreFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="filename.so"
                android:textSize="10sp"
                android:textColor="#666666"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Download/Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="DOWNLOAD"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:backgroundTint="#2196F3"
            android:textColor="@android:color/white"
            app:cornerRadius="0dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

