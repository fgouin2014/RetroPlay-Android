<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kitt_black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/kitt_dark_red"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/kitt_red"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONSOLE MANAGER"
            android:textSize="16sp"
            android:textColor="@color/kitt_red"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Buttons for global artwork updates -->
    <LinearLayout
        android:id="@+id/artworkGlobalButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateAllArtworksButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="UPDATE ALL ART"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_upload"
            app:iconGravity="textStart"
            app:backgroundTint="@color/kitt_blue"
            android:textColor="@android:color/white"
            app:cornerRadius="0dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fillMissingArtworksButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="FILL MISSING ART"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart"
            app:backgroundTint="@color/kitt_green_alpha"
            android:textColor="@android:color/white"
            app:cornerRadius="0dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Liste des consoles -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/consolesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp" />

    <!-- Boutons principaux -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanAllButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="SCAN ALL"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconGravity="textStart"
            app:backgroundTint="@color/kitt_blue"
            android:textColor="@android:color/white"
            app:cornerRadius="0dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importXmlButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="IMPORT XML"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_upload"
            app:iconGravity="textStart"
            app:backgroundTint="#FF9800"
            android:textColor="@android:color/black"
            app:cornerRadius="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addConsoleButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="ADD"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:backgroundTint="@color/kitt_red"
            android:textColor="@android:color/black"
            app:cornerRadius="0dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>
    
    <!-- Boutons secondaires -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manageCoresButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="MANAGE CORES"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:icon="@android:drawable/stat_sys_download"
            app:iconGravity="textStart"
            app:backgroundTint="#00BCD4"
            android:textColor="@android:color/white"
            app:cornerRadius="0dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/installCheatsButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="INSTALL CHEATS"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:backgroundTint="#9C27B0"
            android:textColor="@android:color/white"
            app:cornerRadius="0dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>

